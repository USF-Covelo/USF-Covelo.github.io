rules_version = '2';
// Regras de segurança da base de dados (copiar para Consola Firebase → Firestore → Regras)
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function dono(uid) { return autenticado() && request.auth.uid == uid; }
    function texto(v, max) { return v is string && v.size() <= max; }

    function dadosValidos(d) {
      return texto(d.nomeCompleto, 120) && d.nomeCompleto.size() > 3
        && d.numeroUtente.matches('^[0-9]{9}$')
        && d.telemovel.matches('^9[1236][0-9]{7}$')
        && texto(d.morada, 200) && d.morada.size() > 0
        && d.codigoPostal.matches('^[0-9]{4}-[0-9]{3}$')
        && texto(d.localidade, 80) && d.localidade.size() > 0
        && (d.nif == '' || d.nif.matches('^[0-9]{9}$'));
    }

    // Perfil de cada utente: só o próprio lê e altera
    match /utentes/{uid} {
      allow read: if dono(uid);
      allow create: if dono(uid)
        && request.resource.data.email == request.auth.token.email
        && dadosValidos(request.resource.data);
      allow update: if dono(uid)
        && request.resource.data.numeroUtente == resource.data.numeroUtente
        && request.resource.data.email == resource.data.email
        && dadosValidos(request.resource.data);
      allow delete: if false;
    }

    // Tabela para entrar com telemóvel / n.º de utente.
    // Só é possível consultar um identificador exato (não é possível listar).
    match /identificadores/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if autenticado() && resource.data.uid == request.auth.uid;
    }
  }
}
